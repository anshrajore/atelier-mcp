{
  "name": "User Lead Enrichment & Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "enrich-lead"
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://api.hunter.io/v2/email-verifier"
      },
      "name": "HTTP Request - Verify Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.data.status }}",
              "value2": "valid"
            }
          ]
        }
      },
      "name": "IF - Email Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "channel": "#leads",
        "text": "New qualified lead verified!"
      },
      "name": "Slack - Notify Team",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [850, 200]
    },
    {
      "parameters": {
        "channel": "#lead-failures",
        "text": "Lead enrichment failed or invalid email."
      },
      "name": "Orphan Slack Fallback Node",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [850, 450]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "HTTP Request - Verify Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request - Verify Email": {
      "main": [
        [
          {
            "node": "IF - Email Valid",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - Email Valid": {
      "main": [
        [
          {
            "node": "Slack - Notify Team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
