{
  "name": "atelier-quality-gate",
  "version": "1.0.0",
  "description": "Two-agent post-generation quality gate (UI/UX Critic & Backend Architecture Guard) for vibe-coded apps",
  "main": "mcp-server/dist/index.js",
  "bin": {
    "atelier-quality-gate": "./bin/atelier.js",
    "atelier": "./bin/atelier.js",
    "atelier-mcp": "./bin/atelier.js"
  },
  "files": [
    "bin",
    "adapters",
    "mcp-server/dist",
    "skills",
    "rulesets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/atelier.js serve",
    "serve": "node bin/atelier.js serve",
    "audit": "node bin/atelier.js audit",
    "fix": "node bin/atelier.js fix",
    "install-adapters": "node bin/atelier.js install all",
    "sync-adapters": "node scripts/sync-adapters.js",
    "check-sync": "node scripts/check-sync.js",
    "build": "cd mcp-server && npm install && npm run build",
    "benchmark": "python3 model/eval/evaluate.py",
    "test": "node scripts/verify-tools.js && node scripts/check-sync.js"
  },
  "keywords": [
    "atelier",
    "quality-gate",
    "ui-critic",
    "backend-guard",
    "ai-agent",
    "cursor",
    "windsurf",
    "claude-code",
    "antigravity",
    "mcp",
    "vibe-coding"
  ],
  "author": "Ansh Rajore (https://github.com/anshrajore)",
  "license": "MIT",
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  }
}
